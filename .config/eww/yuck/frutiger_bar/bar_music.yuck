
;;  Music 
(defwidget frut_bar_music [] 
  (eventbox
    :onhover "eww update music_reveal=true"
    :onhoverlost "eww update music_reveal=false"
    (box
      :class "music_module"
      :orientation "h"
      :space-evenly "false"
      (revealer
        :transition "fade"
        :reveal music_reveal
        :duration "350ms"
        (box :orientation "h" 
          (button
            :class "glass_block"
            :onclick "~/.config/eww/scripts/music/playerctl.sh shuffle"
            ""
          )
          (button 
            :class "glass_block"
            :onclick "~/.config/eww/scripts/music/playerctl.sh toggle-loop"
            ""
          )
        )
      )
      (button

        :class "glass_block song"
        :onclick "~/.config/eww/scripts/popup.ts open music_win"
        (box

          :orientation "h"
          :space-evenly "false"
          (box
            :class "cover_art"
            :style "background-image: url('${
              music_metadata[current_music_player]?.["mpris:artUrl"]
              ?: "images/music.png"
            }');"
            ; :style {
            ;   music_metadata[current_music_player]?.["mpris:artUrl"]
            ;     ? "background-image: url('${
            ;         music_metadata[current_music_player]?.["mpris:artUrl"]
            ;       }');"
            ;     : "min-width: 0px; box-shadow: none; visibility: hidden;"
            ;
            ; }
            ; :text {
            ;   music_metadata[current_music_player]?.["mpris:artUrl"] ? "" : ""
            ;
            ; }

          )
          (label 
            :class "song_title"
            :limit-width 20
            :text {
              music_metadata[current_music_player]?.["xesam:title"] ?: ""
            }
          )
        )
      )
      (revealer
        :transition "fade"
        :reveal music_reveal
        :duration "350ms"
        (box :orientation "h" 
          (button
            :class "glass_block song_btn_prev"
            :onclick "~/.config/eww/scripts/music/playerctl.sh previous"
            ""
          )
          (button 
            :class "glass_block song_btn_play"
            ; :onclick "playerctl --player=${current_music_player} play-pause"
            :onclick "~/.config/eww/scripts/music/playerctl.sh play-pause"
            {song_status_each[current_music_player] == "Playing" ? "󰏤" : "󰐊"} 
          )
          (button 
            :class "glass_block song_btn_next"
            :onclick "~/.config/eww/scripts/music/playerctl.sh next"
            ""
          )
        )
      )
    )
  )
)

